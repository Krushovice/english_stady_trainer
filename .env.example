# Used by the `db` container itself
POSTGRES_USER=english_trainer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=english_trainer
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# Used by the app (Settings). Inside `docker compose`, the api service
# overrides these to point at the `db`/`redis` service names instead
# of localhost — see docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://english_trainer:change-me@localhost:5432/english_trainer
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-too

# AI (Phase 5). Provider is a locally running LM Studio server exposing an
# OpenAI-compatible API — no API key needed, AI_API_KEY is a placeholder value
# the client library still requires. Outside Docker (uvicorn run directly on
# the host), AI_BASE_URL below is correct as-is; docker-compose.yml overrides
# it to http://host.docker.internal:1234/v1 for the containerized api service,
# since LM Studio itself runs natively on the host, not in a container.
AI_PROVIDER=lmstudio
AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=not-needed
AI_MODEL=qwen/qwen3.5-9b
AI_MAX_TOKENS=1500
AI_TIMEOUT_SECONDS=120
